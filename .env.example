# ---------------------------------------------------------------------------
# Nightshift environment
#
# On Vercel, DATABASE_URL is injected automatically when you connect a Postgres
# (Neon) database. The auth variables you set yourself.
#
# Locally, the easiest path is:
#     vercel install neon        # provisions the DB and pulls DATABASE_URL
#     vercel env pull .env.local # or pull everything at once
# ---------------------------------------------------------------------------

# Postgres connection string (Neon integration injects this on Vercel).
# Use the POOLED string — it ends in `-pooler`.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------

# Signing/encryption secret. At least 32 characters, high entropy.
# Generate one with:
#     openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL of the app. Must match where it is actually served, or OAuth
# callbacks will redirect to the wrong host.
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app credentials. Create one at:
#   https://github.com/settings/developers -> New OAuth App
#
#   Homepage URL:               http://localhost:3000  (or your prod URL)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
#
# Add a SECOND callback URL for production once you know your Vercel domain:
#   https://your-app.vercel.app/api/auth/callback/github
# A GitHub OAuth app accepts multiple callback URLs, so one app covers both.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
